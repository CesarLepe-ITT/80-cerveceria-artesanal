{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
  {cowboy, "2.12.0"},
  {jsx, "3.1.0"},
  {recon, "2.5.6"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p80_cerveceria_artesanal]}
]}.

{eunit_opts, [verbose]}.

{relx, [
  {release, {p80_cerveceria_artesanal, "0.1.0"}, [p80_cerveceria_artesanal, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
